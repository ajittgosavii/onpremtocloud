# Copy to .env and fill in. The app also accepts the key typed into the sidebar.
OPENAI_API_KEY=sk-...
# Optional overrides
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# Azure Retail Prices API needs no auth. Set to 0 to force offline fallback pricing.
LIVE_PRICING=1

# --- Sign-in ---------------------------------------------------------------
# Accounts normally live in .streamlit/secrets.toml (see secrets.toml.example).
# This is the local-only alternative: a JSON object of username -> record.
# Each record takes password_hash (from tools_hashpw.py) or password in the clear.
# APP_USERS={"ajit":{"name":"Ajit Gosavi","role":"Owner","password":"change-me"}}
# APP_IDLE_TIMEOUT_MINUTES=480
# APP_SESSION_SECRET=
