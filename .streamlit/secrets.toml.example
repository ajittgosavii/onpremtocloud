# Copy to .streamlit/secrets.toml and edit. That file is gitignored and must stay
# that way. On Streamlit Community Cloud, paste the same content into
# Settings > Secrets instead -- there is no file to copy there.
#
# With no [auth.users] block the application falls back to a single demo account
# (demo / ascend) and says so on the sign-in page. Configure real accounts before
# the deployment is shared.

[auth]
# Signed out after this long without interaction. 0 disables the timeout.
idle_timeout_minutes = 480

# Optional. Signs the "keep me signed in" token. When absent it is derived from
# the stored credentials, which is fine -- set it only if you want tokens to
# survive a password change, or to share one key across replicas.
# session_secret = "a long random string"

# One table per account. Generate password_hash with:
#     py -3.12 tools_hashpw.py --user ajit --name "Ajit Gosavi" --role Owner
[auth.users.ajit]
name = "Ajit Gosavi"
role = "Owner"
password_hash = "pbkdf2_sha256$240000$REPLACE_ME$REPLACE_ME"

# A plaintext password is accepted too. Only do this for a local demo.
# [auth.users.guest]
# name = "Client guest"
# role = "Read only"
# password = "change-me"

# The AI advisor key can live here as well, instead of in .env.
# OPENAI_API_KEY = "sk-..."
